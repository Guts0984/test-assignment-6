# Copy to .env:  cp .env.example .env
# Parsed and validated by src/server/env.ts (zod). Non-secret vars have defaults in code;
# the values below are the local-development / docker-compose values.

# --- app (non-secret)
NODE_ENV=production
APP_URL=http://localhost:3000
DEFAULT_LOCALE=uk

# --- postgres (docker compose reads these too)
POSTGRES_USER=calendar
POSTGRES_PASSWORD=calendar_dev_password
POSTGRES_DB=calendar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full URL; must match the values above. For `pnpm dev` on the host use host localhost.
DATABASE_URL=postgres://calendar:calendar_dev_password@postgres:5432/calendar

# --- auth (secret; dev-only value, change outside local use)
SESSION_SECRET=dev-only-session-secret-change-me-32+chars
SESSION_TTL_DAYS=14
# Reverse proxies of yours in front of the app (each appends to X-Forwarded-For). 0 = reached directly:
# the header is not trusted, and the per-address sign-in limit (100 failures / 15 min) is off.
TRUSTED_PROXY_HOPS=0

# --- seed (demo accounts: ana@example.com, bob@example.com, kenji@example.com)
SEED_USER_PASSWORD=demo1234
